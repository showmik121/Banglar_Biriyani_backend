{
  "name": "banglar-biriyani-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Banglar Biriyani REST API (Hono + Supabase PostgreSQL + Drizzle)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest tests/unit",
    "db:push": "drizzle-kit push",
    "db:upgrade": "tsx src/db/upgrade.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:set-admin": "tsx src/db/set-admin.ts",
    "db:remove-demo": "tsx src/db/remove-demo-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
