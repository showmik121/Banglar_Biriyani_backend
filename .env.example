# Copy this file to .env and replace the values. Never commit .env to GitHub.

# Neon PostgreSQL connection strings (Neon dashboard -> Connection details)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.neon.tech/neondb?sslmode=require

# Secret used to sign login sessions. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (the frontend dev server forwards /api here)
API_PORT=3001

# development | production
NODE_ENV=development

# Passwords for the admin and kitchen staff accounts created by `npm run db:seed`.
# Leave empty only for local testing (demo passwords are used then).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
