# Copy this file to .env and replace the values. Never commit .env to GitHub.

# Supabase PostgreSQL (Supabase dashboard -> Connect button at the top).
# DATABASE_URL: the "Transaction pooler" string (port 6543), used by the API.
# DATABASE_URL_UNPOOLED: the "Session pooler" string (port 5432), used by db:push and db:seed.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL_UNPOOLED=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Secret used to sign login sessions. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (the frontend dev server forwards /api here)
API_PORT=3001

# development | production
NODE_ENV=development

# Passwords for the admin and kitchen staff accounts created by `npm run db:seed`.
# Leave empty only for local testing (demo passwords are used then).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
