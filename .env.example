# Copy this file to .env and replace the values. Never commit .env to GitHub.

# Supabase PostgreSQL (Supabase dashboard -> Connect button at the top).
# DATABASE_URL: the "Transaction pooler" string (port 6543), used by the API.
# DATABASE_URL_UNPOOLED: the "Session pooler" string (port 5432), used by db:push and db:seed.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL_UNPOOLED=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# Secret used to sign login sessions. REQUIRED on the live site.
# It must be at least 32 random characters: on the live site the API refuses to sign anyone in
# with a shorter one, or with the placeholder below. Never reuse it anywhere else.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on (the frontend dev server forwards /api here)
API_PORT=3001

# development | test | production
# Must be "production" on the live site (Supabase -> Edge Functions -> Secrets):
# login cookies then get the Secure flag and error details are hidden from visitors.
# deploy-supabase.bat sets this for you. Anything other than development/test is treated
# as the live site, so a forgotten value fails safe.
NODE_ENV=development

# Passwords for the accounts created by `npm run db:seed`.
# SEED_ADMIN_PASSWORD is REQUIRED (at least 10 characters): the seed refuses to run without it
# and never falls back to a built-in demo password. SEED_STAFF_PASSWORD is only used for the
# test-only staff account (SEED_DEMO_DATA=true).
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# Local testing only: also create a demo customer and a sample order (true | false).
# Never use on the live database.
# SEED_DEMO_DATA=false

# Local testing only: "off" lets orders through at any hour instead of only in meal hours.
# Leave unset on the live site.
# MEAL_WINDOWS=off

# Order update emails (optional) — Brevo free plan, 300 emails/day.
# Put the real values in Supabase → Edge Functions → Secrets, never in git.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Banglar Biriyani
SITE_URL=https://banglarbiriyani.netlify.app
# Restaurant inbox(es), comma separated: gets an email for every new order (Supabase secret, not git)
OWNER_NOTIFY_EMAIL=

# Optional: extra websites allowed to call the API from a browser (comma separated, full
# addresses with https://, no wildcards). Example: https://www.client-domain.com,https://client-domain.com
# Not needed for the normal Netlify setup: Netlify forwards /api, so the shop is same-origin,
# and SITE_URL above is always allowed automatically. A trailing slash is ignored.
# localhost is only allowed while NODE_ENV is development or test, never on the live site.
ALLOWED_ORIGINS=

# Only when you change the admin login (then run change-admin.bat and delete these lines again):
# NEW_ADMIN_PASSWORD=
# ADMIN_EMAIL=admin@banglarbiriyani.com
# NEW_ADMIN_EMAIL=
# NEW_ADMIN_PHONE=
# Only to wipe the database and start over (this ERASES all accounts and orders):
# SEED_FORCE=true
